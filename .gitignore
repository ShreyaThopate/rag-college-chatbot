# Dependency directories
node_modules/
**/node_modules/

# Environment files and credentials (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Always allow .env.example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Build outputs
dist/
**/dist/
build/
**/build/

# Uploads & temporary vector cache
data/
**/data/*
!backend/data/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Logs and runtime traces
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# IDE, OS, and system metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
