# CollegeGPT Backend Environment Configuration

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/collegegpt
JWT_SECRET=your_super_secret_jwt_key_change_in_production
CLIENT_URL=http://localhost:5173

# AI & LLM Providers (Optional for local testing; highly recommended for production)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Embedding Model (Default uses local pure-Node SentenceTransformers: Xenova/all-MiniLM-L6-v2)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# RAG Configuration
TOP_K=5
SIMILARITY_THRESHOLD=0.25
